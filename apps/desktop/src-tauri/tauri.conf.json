{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "urh",
  "version": "0.1.0",
  "identifier": "io.github.stevenjoezhang.urh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "urh",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 550,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
